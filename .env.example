# Telegram
BOT_TOKEN=put_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
TELEGRAM_PROXY_URL=
TELEGRAM_REQUEST_TIMEOUT=60

# Runtime
DATABASE_PATH=data/bot.sqlite3
CONTENT_PATH=data/content.json
BOOK1_FILE_PATH=книга 1.pdf
BOOK2_FILE_PATH=книга 2.pdf
TIMEZONE=Europe/Moscow

# Prices, RUB
BOOK_PRICE_RUB=1500
BUNDLE_PRICE_RUB=2400

# Payments: test | manual | telegram | yoomoney
# test: кнопка тестовой оплаты сразу выдает материалы.
# manual: бот создает заказ и показывает реквизиты, админ подтверждает /admin_confirm.
# telegram: Telegram Payments через provider token.
# yoomoney: ручная оплата на карту/кошелек с подтверждением администратором.
PAYMENT_MODE=yoomoney
PAYMENT_PROVIDER_NAME=ЮMoney
TELEGRAM_PROVIDER_TOKEN=
PAYMENT_CURRENCY=RUB
MANUAL_PAYMENT_DETAILS=Перевод на карту. После оплаты отправьте чек в этот чат.
YOOMONEY_CARD_NUMBER=0000000000000000
ENABLE_TEST_PAYMENTS=true

# AI consultant: optional OpenAI-compatible chat/completions API.
# Если не заполнить AI_API_KEY, консультант работает локально по смысловой базе книг.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.2

# Consent-based warmup
WARMUP_ENABLED=true
WARMUP_INTERVAL_HOURS=24
MAX_BROADCAST_PER_MINUTE=20
